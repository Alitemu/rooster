# Dienstrooster Environment Configuration

# Database
DATABASE_URL=file:./rooster.db

# Docker Compose only: where the database and preferences CSV backups
# (lib/preferencesBackup.ts) live on the HOST, bind-mounted into the web
# container's /data. Defaults to a plain ./data folder next to
# docker-compose.yml - not a Docker-managed named volume - so a NAS's own
# file manager (e.g. Synology File Station) can browse it directly.
# Point this at an absolute path on a different disk/share if you'd
# rather keep it elsewhere - but note that only the default ./data comes
# pre-created (as an empty, git-tracked folder - see data/.gitkeep): a
# custom DATA_DIR must already exist as a real folder before the first
# `docker compose up`, or the bind mount has nothing to attach to.
# DATA_DIR=./data

# Port the app is reachable on, https://localhost:<APP_PORT>.
# Host and container port move together, so this one value is enough.
APP_PORT=8010

# Public base URL. Only needed if you reach the app on something other
# than localhost - it is what the exported personal links point at.
# BASE_URL=https://rooster.example.org:8010

# Session signing secret. OPTIONAL: left empty, the app generates one on
# first start and stores it beside the database (in DATA_DIR above),
# so sessions keep working across restarts. Set it to pin your own:
#   openssl rand -hex 32
SESSION_SECRET=

# Auto-creates the planner account (codenaam "planner", lowercase - login
# is case-sensitive) and demo data (31 pseudonymous participants, a sample
# period) the first time DATA_DIR is empty. The account is
# seeded with:
#
#   Password123!
#
# checked into scripts/seed.ts (DEFAULT_TEST_PASSWORD) at the operator's
# explicit request, for easy testing from a phone with no file editing
# needed. CHANGE IT (see that constant, or set SEED_PLANNER_PASSWORD below
# - though that only has an effect on an account that doesn't already have
# a password) before this points at real staff and real schedules - anyone
# with read access to this repo, now or in its git history, knows this
# password. Safe to leave SEED_ON_START on across restarts and
# reinstalls - it only ever acts once, on a genuinely fresh database. Set
# to false for a deployment where you don't want the demo participants and
# sample period created automatically (you'll then need another way to
# create the planner account).
SEED_ON_START=true

# Optional: override the git-committed default password above for the
# planner account, without editing scripts/seed.ts. Applied directly when
# the seed creates the planner account (SEED_ON_START=true), so it needs a
# fresh (or --reset) database to have any effect - the seed only ever
# creates that account once. Still has to pass the same strength rules as
# the /planner/login form (12+ chars, upper+lower+digit+symbol) - a weak
# value here is just skipped in favor of the default, not weakened. This
# file (.env) is gitignored, so a password put here never enters the repo.
# SEED_PLANNER_PASSWORD=

# Container timezone (both web and solver). Defaults to Europe/Amsterdam -
# override only if this deployment serves a ward in a different timezone.
# TZ=Europe/Amsterdam

# Solver Service
SOLVER_URL=http://solver:8000

# Next.js
NODE_ENV=development

# Solver service log verbosity (Python's logging levels: DEBUG, INFO,
# WARNING, ERROR). An unset or unrecognised value falls back to INFO.
LOG_LEVEL=INFO

# In-app notifications for planner overrides (a manual assignment onto a
# blocked/part-time-free day, or over the window rule) are built but kept
# off by default: there's no email or push channel yet
# (dienstrooster_notification_log's gemaild_op/geexporteerd_op tracking is
# the not-yet-built plumbing for that), so an in-app-only notice could sit
# unread as someone's only record that their schedule changed. Set to
# true once that's no longer a concern - no code change needed. See
# lib/notifications.ts.
NOTIFICATIONS_ENABLED=false

# (Add more as needed in later phases)
