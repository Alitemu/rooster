# Dienstrooster Environment Configuration

# Database
DATABASE_URL=file:./rooster.db

# Session signing secret - REQUIRED in production. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Solver Service
SOLVER_URL=http://solver:8000

# Next.js
NODE_ENV=development
NEXT_PUBLIC_SOLVER_URL=http://solver:8000

# Logging
LOG_LEVEL=INFO

