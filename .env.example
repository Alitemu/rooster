# Dienstrooster Environment Configuration

# Database
DATABASE_URL=file:./rooster.db

# Port the app is reachable on, https://localhost:<APP_PORT>.
# Host and container port move together, so this one value is enough.
APP_PORT=8010

# Public base URL. Only needed if you reach the app on something other
# than localhost - it is what the exported personal links point at.
# BASE_URL=https://rooster.example.org:8010

# Session signing secret. OPTIONAL: left empty, the app generates one on
# first start and stores it beside the database (in the db_data volume),
# so sessions keep working across restarts. Set it to pin your own:
#   openssl rand -hex 32
SESSION_SECRET=

# Set true to auto-create the ADMIN/PLANNER accounts and demo data (30
# pseudonymous participants, a sample period) the first time the db_data
# volume is empty. Safe to leave on across restarts and reinstalls - it
# only ever acts once, on a genuinely fresh database. Leave unset/false
# for a real deployment with real staff, where you don't want a
# publicly-documented ADMIN/PLANNER password to exist by default.
SEED_ON_START=false

# Solver Service
SOLVER_URL=http://solver:8000

# Next.js
NODE_ENV=development
NEXT_PUBLIC_SOLVER_URL=http://solver:8000

# Logging
LOG_LEVEL=INFO

# (Add more as needed in later phases)
