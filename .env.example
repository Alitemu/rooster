# Dienstrooster Environment Configuration

# Database
DATABASE_URL=file:./rooster.db

# Port the app is reachable on, https://localhost:<APP_PORT>.
# Host and container port move together, so this one value is enough.
APP_PORT=8010

# Public base URL. Only needed if you reach the app on something other
# than localhost - it is what the exported personal links point at.
# BASE_URL=https://rooster.example.org:8010

# Session signing secret. OPTIONAL: left empty, the app generates one on
# first start and stores it beside the database (in the db_data volume),
# so sessions keep working across restarts. Set it to pin your own:
#   openssl rand -hex 32
SESSION_SECRET=

# Auto-creates the ADMIN/PLANNER accounts and demo data (30 pseudonymous
# participants, a sample period) the first time the db_data volume is
# empty. Neither account gets a password from seeding - opening
# /planner/login for the first time asks you to set one for each, so no
# password ever lives in this repo. Safe to leave on across restarts and
# reinstalls - it only ever acts once, on a genuinely fresh database. Set
# to false for a deployment where you don't want the demo participants
# and sample period created automatically.
SEED_ON_START=true

# Optional: skip the interactive /planner/login "first run" password form
# and claim ADMIN/PLANNER with a password of your own choosing on startup
# instead. Leave commented out to keep using the form. Only takes effect
# on an account that doesn't have a password yet (same one-time-claim rule
# as the form), so it's safe to leave set across restarts. Still has to
# pass the same strength rules as the form (12+ chars, upper+lower+digit+
# symbol) - a weak value here is just skipped, not weakened.
#
# This file (.env) is gitignored - unlike SEED_ON_START above, a password
# put here never enters this repo, which is the whole point of the two
# accounts not getting one from scripts/seed.ts in the first place.
# SEED_ADMIN_PASSWORD=
# SEED_PLANNER_PASSWORD=

# Solver Service
SOLVER_URL=http://solver:8000

# Next.js
NODE_ENV=development
NEXT_PUBLIC_SOLVER_URL=http://solver:8000

# Logging
LOG_LEVEL=INFO

# (Add more as needed in later phases)
